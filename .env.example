# Admin (Vercel) → live storefront https://hatikvahcare.com
# Use the SAME database + storage as the live site.

VITE_STORE_URL="https://hatikvahcare.com"

DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Product image uploads (Supabase S3 / compatible)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT="https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3"
S3_REGION="ap-south-1"
S3_BUCKET_NAME="products"

# Admin login
STORE_LOGIN_EMAIL="your-admin-email@example.com"
STORE_LOGIN_PASSWORD="change-me"

# Optional: seals the httpOnly admin session cookie
# ADMIN_SESSION_SECRET="replace-with-a-long-random-string"
